{
  "name": "@surefold/grid",
  "version": "0.2.0",
  "description": "A data grid whose rows, formulas and totals are worked out incrementally by the watershed engine, in WebAssembly.",
  "license": "Apache-2.0",
  "homepage": "https://surefold.dev/watershed/grid/",
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/surefold/watershed.git",
    "directory": "packages/grid"
  },
  "type": "module",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./demo": {
      "source": "./src/demo-entry.ts",
      "types": "./dist/demo-entry.d.ts",
      "default": "./dist/demo-entry.js"
    },
    "./grid.css": {
      "source": "./src/grid.css",
      "default": "./dist/grid.css"
    }
  },
  "files": [
    "dist",
    "pkg/watershed_grid.js",
    "pkg/watershed_grid.d.ts",
    "pkg/watershed_grid_bg.wasm",
    "pkg/watershed_grid_bg.wasm.d.ts"
  ],
  "sideEffects": [
    "*.css",
    "./src/worker.ts",
    "./dist/worker.js"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json && cp src/view.js src/view.d.ts src/chart.js src/chart.d.ts src/grid.css dist/ && sed -i.bak 's#\"./worker.ts\"#\"./worker.js\"#' dist/remote.js && rm dist/remote.js.bak",
    "check": "tsc --noEmit -p ."
  }
}
