{
  "name": "watershed-grid-e2e",
  "private": true,
  "type": "module",
  "description": "Browser tests of the grid's pages, cookbooks and onEdit, with Playwright. Needs web/build.sh to have built web/dist first.",
  "scripts": {
    "build": "vite build",
    "test": "playwright test --trace off",
    "e2e": "vite build && playwright test --trace off",
    "check": "tsc --noEmit -p ."
  },
  "dependencies": {
    "@surefold/grid": "0.4.0"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "^22.0.0",
    "typescript": "^5.8.0",
    "vite": "^6.3.0"
  }
}
