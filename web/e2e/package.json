{
  "name": "watershed-grid-e2e",
  "private": true,
  "type": "module",
  "description": "Browser tests of the grid's pages, cookbooks and onEdit, with Playwright. Needs web/build.sh to have built web/dist first.",
  "scripts": {
    "build": "vite build",
    "test": "playwright test --trace off",
    "e2e": "vite build && playwright test --trace off",
    "check": "tsc --noEmit -p ."
  },
  "dependencies": {
    "@solidjs/web": "^2.0.3",
    "@surefold/grid": "0.5.0",
    "@surefold/grid-react": "0.5.0",
    "@surefold/grid-solid": "0.5.0",
    "effect": "4.1.2",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "solid-js": "^2.0.3"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@solidjs/vite-plugin": "^3.0.1",
    "@types/node": "^22.0.0",
    "@vitejs/plugin-react": "^6.3.0",
    "typescript": "^5.8.0",
    "vite": "^8.3.0"
  }
}
