"""Type hints for watershed, an incremental calculation engine written in Rust."""

from typing import Literal, Sequence, Union

Scalar = Union[float, int, bool, str]
ExprLike = Union["Expr", Scalar]

class CalcError(Exception):
    """A node holds an error (such as a division by zero), or a request does not fit the graph."""

class Expr:
    """A node of a graph, or an expression built from nodes and values.

    Operators build expressions: `+ - * /`, unary `-`, `abs()`, comparisons
    (`< <= > >= == !=`), and `& | ~` on bools. Nothing is calculated until an
    expression is defined as a node. Expressions have no truth value and are
    not hashable, since `==` builds an expression.
    """

    @property
    def type(self) -> Literal["float", "int", "bool", "str"]: ...
    @property
    def id(self) -> int:
        """The node's id in its graph (nodes only)."""
    @property
    def name(self) -> str:
        """The node's name (nodes only)."""
    @property
    def value(self) -> Scalar:
        """The node's value as of the last update; raises CalcError if it is an error."""
    def min(self, other: ExprLike) -> Expr: ...
    def max(self, other: ExprLike) -> Expr: ...
    def __add__(self, other: ExprLike) -> Expr: ...
    def __radd__(self, other: ExprLike) -> Expr: ...
    def __sub__(self, other: ExprLike) -> Expr: ...
    def __rsub__(self, other: ExprLike) -> Expr: ...
    def __mul__(self, other: ExprLike) -> Expr: ...
    def __rmul__(self, other: ExprLike) -> Expr: ...
    def __truediv__(self, other: ExprLike) -> Expr: ...
    def __rtruediv__(self, other: ExprLike) -> Expr: ...
    def __neg__(self) -> Expr: ...
    def __abs__(self) -> Expr: ...
    def __invert__(self) -> Expr: ...
    def __and__(self, other: ExprLike) -> Expr: ...
    def __rand__(self, other: ExprLike) -> Expr: ...
    def __or__(self, other: ExprLike) -> Expr: ...
    def __ror__(self, other: ExprLike) -> Expr: ...
    def __lt__(self, other: ExprLike) -> Expr: ...  # type: ignore[override]
    def __le__(self, other: ExprLike) -> Expr: ...  # type: ignore[override]
    def __gt__(self, other: ExprLike) -> Expr: ...  # type: ignore[override]
    def __ge__(self, other: ExprLike) -> Expr: ...  # type: ignore[override]
    def __eq__(self, other: ExprLike) -> Expr: ...  # type: ignore[override]
    def __ne__(self, other: ExprLike) -> Expr: ...  # type: ignore[override]

class When:
    def then(self, value: ExprLike) -> Then: ...

class Then:
    def otherwise(self, value: ExprLike) -> Expr: ...

def when(condition: ExprLike) -> When:
    """Starts a condition: when(c).then(a).otherwise(b). Only the branch taken is evaluated."""

def choose(index: ExprLike, options: Sequence[ExprLike]) -> Expr:
    """The option at position `index` (from 0); an index out of range is an error."""

class Report:
    """What one call to Graph.stabilize() did."""

    epoch: int
    inputs_changed: int
    recalculated: int
    changed: int

class Graph:
    """A graph of inputs and calculated nodes."""

    def __init__(self) -> None: ...
    def input(self, name: str, value: Scalar) -> Expr: ...
    def define(self, name: str, expr: ExprLike) -> Expr: ...
    def set(self, node: Expr, value: Scalar) -> None:
        """Records a new value for an input; it takes effect at the next stabilize()."""
    def stabilize(self) -> Report:
        """Applies the recorded changes, recalculating only what depends on them."""
    def get(self, node: Expr) -> Scalar: ...
    def explain(self, node: Expr) -> str: ...
    def describe(self) -> str: ...
    def to_dot(self) -> str: ...
    def last_recalculated(self) -> list[str]: ...
    def find(self, name: str) -> Expr | None: ...
    def check_consistency(self) -> None: ...
    def set_parallel_threshold(self, nodes: int) -> None: ...
    def collection(self, name: str) -> Collection: ...
    def __len__(self) -> int: ...

class Collection:
    """A keyed table of rows, with fields, calculated columns and totals."""

    def field(self, name: str, type: type[float] | type[int] | type[bool] | type[str]) -> Expr: ...
    def column(self, name: str, formula: ExprLike) -> Expr: ...
    def sum(self, name: str, of: Expr) -> Expr: ...
    def min(self, name: str, of: Expr) -> Expr: ...
    def max(self, name: str, of: Expr) -> Expr: ...
    def count(self, name: str) -> Expr: ...
    def upsert(self, key: str, **fields: Scalar) -> None: ...
    def remove(self, key: str) -> bool: ...
    def get(self, key: str, of: Expr) -> Scalar: ...
    def keys(self) -> list[str]: ...
    def __len__(self) -> int: ...
    def __contains__(self, key: str) -> bool: ...
